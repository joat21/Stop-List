generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model StopListEntry {
  id         String    @id @default(uuid())
  dishId     String
  reason     String
  stoppedAt  DateTime
  expiresAt  DateTime
  returnedAt DateTime?
}
